# Embedding Service (BGE-M3)
# Default binds all interfaces for launchd/manual runs. Set 127.0.0.1 for local-only access.
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=9001
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=mps
EMBEDDING_USE_FP16=false
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=12
EMBEDDING_WORKERS=1
EMBEDDING_LOG_LEVEL=INFO

# Reranker Service (BGE-Reranker-v2-m3)
# Default binds all interfaces for launchd/manual runs. Set 127.0.0.1 for local-only access.
RERANKER_HOST=0.0.0.0
RERANKER_PORT=9002
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=mps
RERANKER_USE_FP16=false
RERANKER_BATCH_SIZE=32
RERANKER_WORKERS=1
RERANKER_LOG_LEVEL=INFO

# Common
# HuggingFace fast tokenizers expect the literal string "false" / "true".
TOKENIZERS_PARALLELISM=false

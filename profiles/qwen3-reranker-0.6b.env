# Qwen/Qwen3-Reranker-0.6B — LLM reranker, official yes/no-logit scoring, task instruction.
# Licence: Apache-2.0. Download ~1.2 GB. Speed floor for the Qwen3 reranker family.
PROFILE_SERVICE=reranker
RERANKER_PORT=9012
RERANKER_BACKEND=qwen3-reranker
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_MODEL_REVISION=
RERANKER_USE_FP16=false
RERANKER_MAX_LENGTH=1024
RERANKER_MAX_LENGTH_CAP=8192
RERANKER_BATCH_SIZE=16
RERANKER_INSTRUCTION="Given a product description, judge whether the customs tariff (HS / ТН ВЭД) heading classifies this product"
RERANKER_TRUST_REMOTE_CODE=false

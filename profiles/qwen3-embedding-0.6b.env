# Qwen/Qwen3-Embedding-0.6B — dense 1024-d, Matryoshka, instruction-aware queries.
# Licence: Apache-2.0. Download ~1.2 GB. Dense only: hybrid search keeps bge-m3 sparse.
# Queries must be sent with "input_type": "query" to get the instruction prefix.
PROFILE_SERVICE=embedding
EMBEDDING_PORT=9011
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=
EMBEDDING_USE_FP16=false
EMBEDDING_MAX_LENGTH=512
EMBEDDING_MAX_LENGTH_CAP=8192
EMBEDDING_BATCH_SIZE=16
# Domain instruction. For generic web-style search use EMBEDDING_QUERY_PROMPT_NAME=query instead.
EMBEDDING_QUERY_PROMPT="Instruct: Given a product description, retrieve the customs tariff (HS / ТН ВЭД) heading that classifies it\nQuery:"
EMBEDDING_QUERY_PROMPT_NAME=
EMBEDDING_DOCUMENT_PROMPT=
EMBEDDING_DOCUMENT_PROMPT_NAME=
EMBEDDING_MATRYOSHKA=true
EMBEDDING_TRUST_REMOTE_CODE=false

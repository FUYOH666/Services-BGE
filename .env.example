# Copy to .env and adjust. Every value below is the built-in default unless noted.
# Variables already set in the calling environment win over .env, so you can run a
# side copy with e.g. `EMBEDDING_PORT=9101 ./scripts/run_service.sh embedding`.

# --- Embedding Service (BGE-M3) ---------------------------------------------
# Local-only by default. Set 0.0.0.0 to expose on LAN / Tailscale, and then also
# set SERVICE_API_KEY below.
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=9001
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: pin a Hugging Face commit sha or tag for reproducible restarts.
# EMBEDDING_MODEL_REVISION=
EMBEDDING_DEVICE=mps
EMBEDDING_USE_FP16=false
# Default token limit when a request does not send max_length, and the hard cap.
EMBEDDING_MAX_LENGTH=512
EMBEDDING_MAX_LENGTH_CAP=8192
EMBEDDING_BATCH_SIZE=12
# Request limits (0 disables): texts per request, characters per text.
EMBEDDING_MAX_ITEMS=256
EMBEDDING_MAX_TEXT_CHARS=100000
EMBEDDING_WORKERS=1
EMBEDDING_LOG_LEVEL=INFO
# uvicorn access log line per request (true/false).
EMBEDDING_ACCESS_LOG=true
EMBEDDING_SLOW_REQUEST_MS=2000
EMBEDDING_WARMUP=true
# 0 = empty the MPS cache after every request (historical behaviour).
# >0 = only when the Metal driver holds more than this many MB (e.g. 6000).
EMBEDDING_MPS_CACHE_THRESHOLD_MB=0

# --- Reranker Service (BGE-Reranker-v2-m3) -----------------------------------
RERANKER_HOST=127.0.0.1
RERANKER_PORT=9002
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_MODEL_REVISION=
RERANKER_DEVICE=mps
RERANKER_USE_FP16=false
RERANKER_BATCH_SIZE=32
RERANKER_MAX_LENGTH=512
RERANKER_MAX_LENGTH_CAP=8192
RERANKER_MAX_DOCUMENTS=1000
RERANKER_MAX_TEXT_CHARS=100000
RERANKER_WORKERS=1
RERANKER_LOG_LEVEL=INFO
RERANKER_ACCESS_LOG=true
RERANKER_SLOW_REQUEST_MS=2000
RERANKER_WARMUP=true
RERANKER_MPS_CACHE_THRESHOLD_MB=0

# --- MCP memory server (docs/AGENT-MEMORY.md) ------------------------------------
# Agents start it over stdio with scripts/mcp.sh; ./scripts/run_service.sh mcp serves HTTP.
# MCP_HOST=127.0.0.1
# MCP_PORT=9003
# Required from HTTP clients when set; mandatory for a non-loopback MCP_HOST.
# MCP_API_KEY=
# MCP_QDRANT_URL=http://127.0.0.1:6333
# MCP_DEFAULT_COLLECTION=memory
# Folders remember(path=...) may read, separated by ":".
# MCP_ALLOWED_PATHS=~

# --- Common ------------------------------------------------------------------
# Optional shared API key for POST endpoints (Bearer or X-API-Key header).
# Empty = no auth. Per-service overrides: EMBEDDING_API_KEY / RERANKER_API_KEY.
# SERVICE_API_KEY=
# Unset = auto: offline when the model is already cached. 0/1 forces it.
# HF_HUB_OFFLINE=
# HuggingFace fast tokenizers expect the literal string "false" / "true".
TOKENIZERS_PARALLELISM=false

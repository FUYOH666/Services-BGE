# Qwen/Qwen3-Reranker-4B — the quality candidate for replacing bge-reranker-v2-m3.
# Licence: Apache-2.0. Download ~8 GB; fp16 keeps it at ~8-9 GB of memory.
# Same backend as qwen3-reranker-0.6b; run the eval before trusting it.
PROFILE_SERVICE=reranker
RERANKER_PORT=9014
RERANKER_BACKEND=qwen3-reranker
RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
RERANKER_MODEL_REVISION=
RERANKER_USE_FP16=true
RERANKER_MAX_LENGTH=1024
RERANKER_MAX_LENGTH_CAP=8192
RERANKER_BATCH_SIZE=8
RERANKER_INSTRUCTION="Given a product description, judge whether the customs tariff (HS / ТН ВЭД) heading classifies this product"
RERANKER_TRUST_REMOTE_CODE=false

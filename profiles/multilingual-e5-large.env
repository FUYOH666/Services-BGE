# intfloat/multilingual-e5-large — dense 1024-d, the classic multilingual baseline.
# Licence: MIT. Download ~2.2 GB. Needs "query: " / "passage: " prefixes.
PROFILE_SERVICE=embedding
EMBEDDING_PORT=9013
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_MODEL_REVISION=
EMBEDDING_USE_FP16=false
EMBEDDING_MAX_LENGTH=512
EMBEDDING_MAX_LENGTH_CAP=512
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_PROMPT="query: "
EMBEDDING_QUERY_PROMPT_NAME=
EMBEDDING_DOCUMENT_PROMPT="passage: "
EMBEDDING_DOCUMENT_PROMPT_NAME=
EMBEDDING_MATRYOSHKA=false
EMBEDDING_TRUST_REMOTE_CODE=false
